# --- Discord application (https://discord.com/developers/applications) ---
DISCORD_TOKEN=your_bot_token
DISCORD_CLIENT_ID=123456789012345678
DISCORD_CLIENT_SECRET=your_oauth2_secret

# --- Discord server ---
GUILD_ID=123456789012345678
# Channel where the bot posts reminders
CHANNEL_ID=123456789012345678
# Only members with this role can sign in to the website
ALLOWED_ROLE_ID=123456789012345678

# --- Website ---
# Only for the bundled Caddy (docker compose --profile caddy): domain to get an HTTPS certificate for
DOMAIN=fridge.example.com
BASE_URL=https://fridge.example.com
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change_me
WEB_HOST=0.0.0.0
WEB_PORT=8080

# --- Reminders ---
TIMEZONE=Europe/Paris
REMINDER_TIMES=09:00,12:00,16:00
DB_PATH=data/fridge.db
